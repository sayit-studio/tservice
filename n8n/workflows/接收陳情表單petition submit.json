            { "key": "行動電話|phone_number", "phoneValue": "={{ $json.phone }}" },
            { "key": "聯絡Email|rich_text", "textContent": "={{ $json.email }}" },
            { "key": "通訊地址|rich_text", "textContent": "={{ $json.address }}" },
            { "key": "託辦事項|rich_text", "textContent": "={{ $json.caseContent }}" },
            { "key": "處理狀況|select", "selectValue": "處理中" },
            { "key": "公開摘要|rich_text", "textContent": "={{ $json.summary }}" },
