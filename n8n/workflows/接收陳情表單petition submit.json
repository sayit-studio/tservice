      "id": "petition-submit-query-cases",
      "name": "Query Existing Cases",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2,
      "position": [520, -260],
      "credentials": {
        "notionApi": {
          "id": "TUc2PAbFfQKWYUgA",
          "name": "Notion-n8n"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const body = $('Petition Submit Webhook').first().json.body || $('Petition Submit Webhook').first().json || {};\nconst now = new Date();\nconst taipei = new Date(now.toLocaleString('en-US', { timeZone: 'Asia/Taipei' }));\nconst rocYear = taipei.getFullYear() - 1911;\nconst mm = String(taipei.getMonth() + 1).padStart(2, '0');\nconst dd = String(taipei.getDate()).padStart(2, '0');\nconst prefix = `${rocYear}${mm}${dd}`;\nfunction getString(prop) {\n  if (!prop) return '';\n  if (prop.type === 'title') return (prop.title || []).map(t => t.plain_text || '').join('');\n  if (prop.type === 'rich_text') return (prop.rich_text || []).map(t => t.plain_text || '').join('');\n  return '';\n}\nconst maxSerial = $input.all().map(item => getString(item.json.properties?.['請託案號']))\n  .filter(value => value.startsWith(prefix))\n  .map(value => Number(value.slice(prefix.length)))\n  .filter(Number.isFinite)\n  .reduce((max, value) => Math.max(max, value), 0);\nconst caseId = `${prefix}${String(maxSerial + 1).padStart(3, '0')}`;\nconst caseTitle = String(body.caseTitle || '').trim();\nconst caseContent = String(body.caseContent || '').trim();\nreturn [{ json: {\n  caseId,\n  requestDate: `${taipei.getFullYear()}-${mm}-${dd}`,\n  caseType: String(body.caseType || '').trim(),\n  caseArea: String(body.caseArea || '').trim(),\n  caseContent: [caseTitle, caseContent].filter(Boolean).join('\\n\\n'),\n  summary: caseTitle,\n  name: String(body.name || '').trim(),\n  phone: String(body.phone || '').trim(),\n  email: String(body.email || '').trim(),\n  address: String(body.address || '').trim(),\n  createdAt: now.toISOString()\n} }];"
      },
      "id": "petition-submit-prepare",
      "name": "Prepare Case Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, -260]
    },
