                  {
                      "parameters":  {
                                         "jsCode":  "const input = $(\u0027Validate Payload\u0027).first().json;\nif (!input.ok) return [{ json: input }];\nfunction textFromValue(value) {\n  if (value == null) return \u0027\u0027;\n  if (typeof value === \u0027string\u0027 || typeof value === \u0027number\u0027 || typeof value === \u0027boolean\u0027) return String(value);\n  if (Array.isArray(value)) return value.map(textFromValue).filter(Boolean).join(\u0027,\u0027);\n  if (value.name) return String(value.name);\n  if (value.plain_text) return String(value.plain_text);\n  if (value.title) return textFromValue(value.title);\n  if (value.rich_text) return textFromValue(value.rich_text);\n  if (value.select) return textFromValue(value.select);\n  if (value.multi_select) return textFromValue(value.multi_select);\n  if (value.date) return value.date.start || \u0027\u0027;\n  if (value.checkbox != null) return String(value.checkbox);\n  if (value.number != null) return String(value.number);\n  if (value.url) return String(value.url);\n  return \u0027\u0027;\n}\nfunction prop(json, names) {\n  const wanted = Array.isArray(names) ? names : [names];\n  for (const name of wanted) {\n    if (json[name] != null) return textFromValue(json[name]).trim();\n    const p = json.properties?.[name];\n    if (p != null) return textFromValue(p).trim();\n  }\n  const props = json.properties || {};\n  for (const [key, value] of Object.entries(props)) {\n    if (wanted.some((name) =\u003e key.trim() === name || key.includes(name))) return textFromValue(value).trim();\n  }\n  return \u0027\u0027;\n}\nconst events = $(\u0027Query Events\u0027).all();\nconst event = events.find((item) =\u003e item.json.id === input.eventId);\nif (!event) {\n  return [{ json: { ok: false, statusCode: 404, message: \u0027?曆??唳暑??隢Ⅱ隤????臬甇?Ⅱ\u0027 } }];\n}\nconst eventJson = event.json;\nconst title = prop(eventJson, [\u0027瘣餃?銝駁?\u0027, \u0027title\u0027, \u0027Name\u0027]);\nconst enabledRaw = prop(eventJson, [\u0027?勗?銵典\u0027, \u0027registrationEnabled\u0027]);\nconst enabled = [\u0027true\u0027, \u0027??勗?\u0027, \u0027?\u0027, \u0027yes\u0027, \u00271\u0027].includes(String(enabledRaw).toLowerCase()) || enabledRaw === \u0027\u0027;\nif (!enabled) {\n  return [{ json: { ok: false, statusCode: 409, message: \u0027甇斗暑????勗?\u0027 } }];\n}\nconst deadline = prop(eventJson, [\u0027?勗??芣迫??\u0027, \u0027registrationDeadline\u0027]);\nif (deadline \u0026\u0026 new Date(deadline).getTime() \u003c Date.now()) {\n  return [{ json: { ok: false, statusCode: 409, message: \u0027甇斗暑?歇?芣迫?勗?\u0027 } }];\n}\nconst limit = Number(prop(eventJson, [\u0027?勗???銝?\u0027, \u0027registrationLimit\u0027]) || 0);\nconst registrations = $(\u0027Query Existing Registrations\u0027).all();\nconst active = registrations.filter((item) =\u003e {\n  const eventId = prop(item.json, [\u0027瘣餃?ID\u0027, \u0027eventId\u0027]);\n  const status = prop(item.json, [\u0027???, \u0027status\u0027]);\n  return eventId === input.eventId \u0026\u0026 status !== \u0027cancelled\u0027;\n});\nif (input.lineUserId) {\n  const duplicate = active.find((item) =\u003e prop(item.json, [\u0027LINE User ID\u0027, \u0027LINE userId\u0027]) === input.lineUserId);\n  if (duplicate) {\n    return [{ json: { ok: false, statusCode: 409, message: \u0027?典歇?勗?甇斗暑??隢???勗?\u0027 } }];\n  }\n}\nif (limit \u003e 0 \u0026\u0026 active.length \u003e= limit) {\n  return [{ json: { ok: false, statusCode: 409, message: \u0027甇斗暑???憿歇皛? } }];\n}\nconst date = new Date();\nconst y = date.getFullYear();\nconst m = String(date.getMonth() + 1).padStart(2, \u00270\u0027);\nconst d = String(date.getDate()).padStart(2, \u00270\u0027);\nconst serial = String(active.length + 1).padStart(3, \u00270\u0027);\nreturn [{ json: { ...input, eventTitle: title, registrationId: `REG-${y}${m}${d}-${serial}`, status: \u0027registered\u0027, createdAt: new Date().toISOString() } }];"
                                     },
