                      "parameters":  {
                                         "jsCode":  "const body = $(\u0027Event Registration Webhook\u0027).first().json.body || {};\nconst data = body.data || {};\nconst required = [\u0027eventId\u0027, \u0027name\u0027, \u0027phone\u0027];\nconst missing = required.filter((key) =\u003e !String(data[key] || \u0027\u0027).trim());\nif (missing.length) {\n  return [{ json: { ok: false, statusCode: 400, message: `蝻箏?敹?甈?嚗?{missing.join(\u0027, \u0027)}` } }];\n}\nconst companions = Number(data.companions || 0);\nif (!Number.isFinite(companions) || companions \u003c 0) {\n  return [{ json: { ok: false, statusCode: 400, message: \u0027??鈭箸?澆??航炊\u0027 } }];\n}\nreturn [{ json: {\n  ok: true,\n  eventId: String(data.eventId).trim(),\n  name: String(data.name).trim(),\n  phone: String(data.phone).trim(),\n  companions,\n  note: String(data.note || \u0027\u0027).trim(),\n  lineUserId: String(data.lineUserId || \u0027\u0027).trim(),\n  lineDisplayName: String(data.lineDisplayName || \u0027\u0027).trim(),\n  liffLanguage: String(data.liffLanguage || \u0027\u0027).trim(),\n  liffOS: String(data.liffOS || \u0027\u0027).trim(),\n  isInClient: Boolean(data.isInClient),\n  submittedAt: body.submittedAt || new Date().toISOString()\n} }];"
                                     },
