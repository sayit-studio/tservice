    {
      "parameters": {
        "jsCode": "const body = $('Public Legal Consultation Webhook').first().json.body || {};\nconst targetDate = body.data?.appointmentDate;\nconst allSlots = ['15:00','15:15','15:30','15:45','16:00','16:15','16:30','16:45','17:00'];\nfunction prop(item, name) {\n  const p = item.json.properties?.[name];\n  if (!p) return item.json[name] ?? '';\n  if (p.type === 'date') return p.date?.start || '';\n  if (p.type === 'select') return p.select?.name || '';\n  if (p.type === 'title') return (p.title || []).map(v => v.plain_text || '').join('');\n  return item.json[name] ?? '';\n}\nconst bookedSlots = items\n  .filter(item => prop(item, '狀態') === 'confirmed')\n  .map(item => prop(item, '預約日期'))\n  .filter(value => value && value.startsWith(targetDate))\n  .map(value => value.slice(11, 16));\nreturn [{ json: { ok: true, availableSlots: allSlots.filter(slot => !bookedSlots.includes(slot)), bookedSlots } }];"
      },
