    {
      "parameters": {
        "jsCode": "const petitionCount = $('計算陳情總案件數').all().length;\n\nconst statsItems = $('取得手動統計設定 DB5').all();\nlet inspections = 0;\nlet interpellations = 0;\nlet proposals = 0;\n\nif (statsItems.length > 0) {\n  const props = statsItems[0].json.properties || {};\n  const getNum = (prop) => {\n    if (!prop || prop.type !== 'number') return 0;\n    return prop.number || 0;\n  };\n  inspections     = getNum(props['地方會勘數量']);\n  interpellations = getNum(props['國會質詢數量']);\n  proposals       = getNum(props['國會提案數量']);\n}\n\nreturn [{\n  json: {\n    success: true,\n    petitions:      petitionCount,\n    inspections,\n    interpellations,\n    proposals\n  }\n}];"
      },
