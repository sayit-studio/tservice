    {
      "parameters": {
        "jsCode": "const body = $('Admin Legal Consultation Webhook').first().json.body || {};\nconst data = body.data || {};\nconst SETTINGS_ID = '__LEGAL_SLOT_SETTINGS__';\nconst DEFAULT_DISABLED = [];\nfunction text(value) {\n  if (value == null) return '';\n  if (typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean') return String(value);\n  if (Array.isArray(value)) return value.map(text).filter(Boolean).join('');\n  if (value.plain_text) return String(value.plain_text);\n  if (value.text?.content) return String(value.text.content);\n  if (value.name) return String(value.name);\n  if (value.title) return text(value.title);\n  if (value.rich_text) return text(value.rich_text);\n  if (value.select) return text(value.select);\n  return '';\n}\nfunction prop(json, names) {\n  const wanted = Array.isArray(names) ? names : [names];\n  for (const name of wanted) {\n    if (json[name] != null) return text(json[name]).trim();\n    if (json.properties?.[name] != null) return text(json.properties[name]).trim();\n  }\n  return '';\n}\nconst pages = $('Query Legal Slot Settings').all();\nconst existing = pages.find((item) => prop(item.json, ['\\u9810\\u7d04\\u7de8\\u865f']) === SETTINGS_ID);\nlet saved = {};\ntry { saved = JSON.parse(prop(existing?.json || {}, ['\\u4e8b\\u4ef6\\u9673\\u8ff0']) || '{}'); } catch (_) { saved = {}; }\nconst disabledSlots = Array.isArray(data.disabledSlots) ? data.disabledSlots.map(String) : Array.isArray(saved.disabledSlots) ? saved.disabledSlots.map(String) : DEFAULT_DISABLED;\nconst settings = { disabledSlots: Array.from(new Set(disabledSlots)), updatedAt: new Date().toISOString() };\nreturn [{ json: {\n  ok: true,\n  action: body.action,\n  isSave: body.action === 'legal.slotSettings.save',\n  pageId: existing?.json?.id || '',\n  shouldUpdate: Boolean(existing?.json?.id),\n  settings,\n  statement: JSON.stringify(settings)\n} }];"
      },
