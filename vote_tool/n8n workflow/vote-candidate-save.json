      "name": "Update Vote Candidate",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2,
      "position": [
        1120,
        420
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, pageId: $('Build Candidate Update').item.json.pageId, name: $('Build Candidate Update').item.json.name, category: $('Build Candidate Update').item.json.category, targetVotes: $('Build Candidate Update').item.json.targetVotes }) }}"
