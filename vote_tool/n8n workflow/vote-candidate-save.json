        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst found = $input.first().json || {};\nconst pageId = String(body.pageId || found.id || '').trim();\nif (!pageId) {\n  throw new Error('????????????????????????');\n}\nreturn [{ json: { pageId, name: String(body.name || '').trim(), category: String(body.category || '').trim(), targetVotes: Math.floor(Number(body.targetVotes) || 0) } }];"
      },
