        "respondWith": "json",
        "responseBody": "={{ (() => {\n  function propByType(json, type) {\n    return Object.values(json.properties || {}).find((value) => value?.type === type);\n  }\n  function title(json) {\n    const prop = propByType(json, 'title');\n    return prop?.title?.[0]?.plain_text || json.name || '';\n  }\n  function select(json) {\n    const prop = propByType(json, 'select');\n    return prop?.select?.name || '';\n  }\n  function number(json) {\n    const prop = propByType(json, 'number');\n    return prop?.number || 0;\n  }\n  function checked(json) {\n    return Object.values(json.properties || {}).some((value) => value?.type === 'checkbox' && value.checkbox === true) || Object.values(json).some((value) => value === true);\n  }\n  const voters = $('Get Voted Voters').all();\n  return JSON.stringify({\n    success: true,\n    candidates: $('Get Vote Candidates').all().map((item) => ({\n      name: title(item.json),\n      category: select(item.json),\n      votes: number(item.json)\n    })),\n    totalVoters: voters.length,\n    votedCount: voters.filter((item) => checked(item.json)).length\n  });\n})() }}"
