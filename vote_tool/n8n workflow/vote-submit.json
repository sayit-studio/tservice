    {
      "parameters": {
        "jsCode": "const selected = String($('Webhook').first().json.body.chairman || '').replace(/\\s+/g, '').trim();\nfunction text(value) {\n  if (value == null) return '';\n  if (typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean') return String(value);\n  if (Array.isArray(value)) return value.map(text).filter(Boolean).join('');\n  if (value.plain_text) return String(value.plain_text);\n  if (value.name) return String(value.name);\n  if (value.title) return text(value.title);\n  if (value.rich_text) return text(value.rich_text);\n  if (value.select) return text(value.select);\n  return '';\n}\nfunction candidateName(json) {\n  if (json.name) return text(json.name);\n  const props = json.properties || {};\n  const titleProp = Object.values(props).find((value) => value?.type === 'title');\n  return text(titleProp);\n}\nconst found = $input.all().find((item) => candidateName(item.json).replace(/\\s+/g, '').trim() === selected);\nif (!found) throw new Error('Candidate not found for chairman: ' + selected);\nreturn [found];"
      },
